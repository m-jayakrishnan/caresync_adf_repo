					"scripts": [
						{
							"type": "Query",
							"text": {
								"value": "UPDATE caresync.watermark\nSET watermark_value = (\n    SELECT MAX(@{activity('read table details').output.firstRow.watermark_column})\n    FROM caresync.table_config\n)",
